{
  "name": "ola-backend",
  "version": "1.0.0",
  "description": "API REST do OLA - Organizacao da Vida Academica",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
