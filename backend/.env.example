# Conexão com o PostgreSQL (ajuste usuário, senha e porta)
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/ola?schema=public"

PORT=3333
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# 64 caracteres hexadecimais. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Opcionais em desenvolvimento (sem eles, os códigos aparecem no terminal)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: fuso usado para definir "hoje" no Dashboard
APP_TIMEZONE=America/Sao_Paulo
